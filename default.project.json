{
  "name": "cultivation-tycoon",
  "servePort": 34875,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "Launch": {
        "$path": "src/first"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "RelicModels": {
        "$path": "assets/relics"
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": { "ScreenOrientation": "LandscapeSensor" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
